---
import { Image } from 'astro:assets';
import { textos, type Idioma } from '../i18n/textos';
import { ruta } from '../lib/rutas';
import Valor from './Valor.astro';

interface Props {
  idioma: Idioma;
  carpeta: string;
  data: {
    titulo?: string;
    rol?: string;
    resumen?: string;
    origen?: string;
    estado?: string;
    portada?: ImageMetadata;
    portadaAlt?: string;
  };
  horizontal?: boolean;
  nivel?: 'h2' | 'h3';
}
const { idioma, carpeta, data, horizontal = false, nivel: Titulo = 'h3' } = Astro.props;
const t = textos[idioma];
const href = ruta(idioma, 'caso', carpeta);
---

<article class:list={['tarjeta', { horizontal }]}>
  <div class="tarjeta-imagen">
    {
      data.portada ? (
        <Image
          src={data.portada}
          alt={data.portadaAlt ?? ''}
          widths={[480, 800, 1200]}
          sizes={horizontal ? '(min-width: 800px) 45vw, 100vw' : '(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw'}
          loading="lazy"
        />
      ) : (
        <span class="pendiente">{t.pendiente}</span>
      )
    }
  </div>
  <div class="tarjeta-cuerpo">
    {data.estado && <p class="tarjeta-estado">{data.estado}</p>}
    {data.origen && <p class="tarjeta-origen">{data.origen}</p>}
    <Titulo class="tarjeta-titulo">
      <a href={href}><Valor valor={data.titulo} idioma={idioma} /></a>
    </Titulo>
    <p class="tarjeta-rol">
      <span class="visualmente-oculto">{t.rol}: </span>
      <Valor valor={data.rol} idioma={idioma} />
    </p>
    <p class="tarjeta-resumen"><Valor valor={data.resumen} idioma={idioma} /></p>
    <span class="tarjeta-ver" aria-hidden="true">{t.verCaso} →</span>
  </div>
</article>

<style>
  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--blanco);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .tarjeta:hover,
  .tarjeta:focus-within {
    border-color: var(--azul);
    box-shadow: 0 8px 24px rgba(2, 4, 38, 0.08);
  }
  .tarjeta-imagen {
    aspect-ratio: 16 / 10;
    background: var(--lavanda);
    display: grid;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--borde);
  }
  .tarjeta-imagen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  .tarjeta-cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--e1);
    padding: var(--e3);
    flex: 1;
  }
  .tarjeta-estado {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--azul);
  }
  .tarjeta-origen {
    font-size: 0.8125rem;
    color: var(--gris);
  }
  .tarjeta-titulo {
    font-size: 1.375rem;
  }
  .tarjeta-titulo a {
    color: var(--marino);
    text-decoration: none;
  }
  /* Toda la tarjeta es clicable sin anidar enlaces */
  .tarjeta-titulo a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .tarjeta-rol {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--azul);
  }
  .tarjeta-resumen {
    color: var(--gris);
    font-size: 0.9375rem;
  }
  .tarjeta-ver {
    margin-top: auto;
    padding-top: var(--e1);
    font-family: var(--titulos);
    font-weight: 600;
    color: var(--azul);
  }
  @media (min-width: 800px) {
    .horizontal {
      flex-direction: row;
    }
    .horizontal .tarjeta-imagen {
      flex: 0 0 45%;
      aspect-ratio: auto;
      min-height: 280px;
      border-bottom: 0;
      border-right: 1px solid var(--borde);
    }
    .horizontal .tarjeta-cuerpo {
      padding: var(--e4);
      justify-content: center;
    }
    .horizontal .tarjeta-titulo {
      font-size: 1.75rem;
    }
    .horizontal .tarjeta-ver {
      margin-top: var(--e1);
    }
  }
</style>
